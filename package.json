{
  "name": "@dellacagna/iban",
  "version": "1.2.0",
  "description": "Validate, format and generate IBAN numbers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "jest --config jestconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint .",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dellacagna/iban.git"
  },
  "keywords": [
    "IBAN",
    "BBAN",
    "Validator",
    "Formatter",
    "Fake",
    "Generator",
    "Generate",
    "ISO 13616",
    "SEPA",
    "validation"
  ],
  "author": "Giovanni Della Cagna",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dellacagna/iban/issues"
  },
  "homepage": "https://github.com/dellacagna/iban#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  }
}
