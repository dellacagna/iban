{
  "name": "@dellacagna/iban",
  "version": "2.0.0",
  "description": "Validate, format and generate IBAN numbers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "jest --config jestconfig.json",
    "build": "tsup",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint .",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "typecheck": "tsc --noEmit",
    "check:exports": "attw --pack ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dellacagna/iban.git"
  },
  "keywords": [
    "IBAN",
    "BBAN",
    "Validator",
    "Formatter",
    "Fake",
    "Generator",
    "Generate",
    "ISO 13616",
    "SEPA",
    "validation"
  ],
  "author": "Giovanni Della Cagna",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dellacagna/iban/issues"
  },
  "homepage": "https://github.com/dellacagna/iban#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
